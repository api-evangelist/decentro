{
  "opencollection": "1.0.0",
  "info": {
    "name": "Decentro KYC & Onboarding Accounts Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "client_secret",
      "value": "{{client_secret}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://in.decentro.tech/v2/ledger/transactions"
          },
          "docs": "List transactions"
        }
      ]
    }
  ],
  "bundled": true
}